{
  "description": "Diagnostic sensor configurations for Homeside debug endpoints",
  "update_interval": 1800,
  "sensors": {
    "heap_available": {
      "name": "Heap Memory Available",
      "unit": "bytes",
      "icon": "mdi:memory",
      "device_class": null,
      "state_class": "measurement"
    },
    "heap_used": {
      "name": "Heap Memory Used",
      "unit": "bytes",
      "icon": "mdi:memory",
      "device_class": null,
      "state_class": "measurement"
    },
    "heap_max": {
      "name": "Heap Memory Max Used",
      "unit": "bytes",
      "icon": "mdi:memory",
      "device_class": null,
      "state_class": "measurement"
    },
    "heap_errors": {
      "name": "Heap Memory Errors",
      "unit": "errors",
      "icon": "mdi:alert-circle",
      "device_class": null,
      "state_class": "total_increasing"
    },
    "os_version": {
      "name": "OS Version",
      "unit": null,
      "icon": "mdi:chip",
      "device_class": null,
      "state_class": null
    },
    "exoline_sessions_active": {
      "name": "EXOline Active Sessions",
